<mvc:View
  xmlns:mvc="sap.ui.core.mvc" xmlns="sap.m" xmlns:layout="sap.ui.layout" xmlns:f="sap.ui.layout.form" xmlns:core="sap.ui.core"
  controllerName="hack2build.myapplication.ext.main.VehicleDetail">

  <Page id="pageDetail"
    title="{i18n>weighingDetail}"
    showNavButton="true"
    navButtonPress=".onNavBack">

    <content>
    <ObjectHeader id="ObjectHeader" title="{i18n>weight}" backgroundDesign="Solid" numberUnit="CurrencyCode" >
      <attributes>
        <ObjectAttribute id="ObjectAttribute" title="{i18n>LicencePlate}" text="{vehicleView>/vehicle/licensePlate}"/>
        <ObjectAttribute id="ObjectAttribute1" title="{i18n>Driver}" text="{vehicleView>/vehicle/driverName}"/>
        <!-- <ObjectAttribute id="ObjectAttribute2" title="Produto" text="{weighingData>/productName}"/> -->        
      </attributes>
      <statuses>
        <ObjectStatus id="ObjectStatus" title="Status" text="on the scale" state="Success"/>
      </statuses>
    </ObjectHeader>
    <IconTabBar id="iconTabFilter1" expanded="{device>/isNoPhone}" class="sapUiSmallMarginBottom sapUiResponsiveContentPadding">
      <items>
      
        <IconTabFilter id="iconTabItemFilter1" key="info" text="{i18n>TransportData}">
          <FlexBox id="flexBoxId1" wrap="Wrap" fitContainer="true" >
            <f:SimpleForm id="simpleFormId1" layout="ResponsiveGridLayout">
                    
              <!-- Hidden ID field (necessário para update) -->
              

              <Label id="labelVehicleAssoc" text="{i18n>Transport}" />
              <Input id="inputVehicleAssoc" editable="true" />

              <Label id="labelDiver" text="{i18n>Driver}" />
              <Input id="inputDriver" value="{vehicleView>/vehicle/driverName}" editable="true" />

              <Label id="labelCompany" text="{i18n>Company}" />
              <Input id="inputCompany" value="{vehicleView>/vehicle/company}" editable="false" />
              
              <Label id="labelProduct" text="{i18n>Product}" />
              <Input id="inputProduct" value="{vehicleView>/vehicle/productName}" editable="false" />
            

            </f:SimpleForm>
          </FlexBox>
            <HBox id="HboxButtons" class="sapUiTinyMarginBegin">
              <Button
                id="btnFindVehicle"
                text="Buscar Dados Veículo"
                type="Emphasized"
                press=".onFindVehicle" />              
            </HBox>
        </IconTabFilter>
        
        <IconTabFilter id="iconTabItemFilter2" key="Pesagem" text="{i18n>Weighing}">
            <FlexBox id="flexBoxId2" wrap="Wrap" fitContainer="true" >
              <f:SimpleForm id="simpleFormId2" layout="ResponsiveGridLayout">
                
                <Input id="inputWeighingIDHidden" value="{weighingData>/ID}" visible="false" />

                <Label id="labelWeighingID" text="{i18n>WeighingCode}" />
                <Input id="inputWeighingID" value="{weighingData>/weighingID}" editable="true" />

                <!-- <Label id="labelVehicleLicensePlate" text="Placa do Veículo" />
                <Input id="inputVehicleLicensePlate" value="{weighingData>/vehicleLicensePlate}" editable="true" /> -->

                <Label id="labelTareWeight" text="{i18n>tareWeight}" />
                <Input id="inputTareWeight" value="{vehicleView>/tareWeight}" type="Number" editable="true" />

                <Label id="labelGrossWeight" text="{i18n>grossWeight}" />
                <Input id="inputGrossWeight" value="{vehicleView>/grossWeight}" type="Number" editable="false" />

                <Label id="labelNetWeight" text="{i18n>netWeight}" />
                <Input id="inputNetWeight" value="{vehicleView>/netWeight}" type="Number" editable="false" />
              </f:SimpleForm>
            </FlexBox>
            <HBox id="HboxButtonsSave">
              <Button
                id="btnpesar"
                text="{i18n>check}"
                type="Emphasized"
                class="sapUiTinyMarginBegin"
                press=".onPesar" />
              <Button
                id="btnSaveWeighing"
                text="{i18n>Save}"
                type="Default"
                class="sapUiTinyMarginBegin"
                press=".onSaveWeighing" />
              <Button
                id="btnCancelWeighing"
                text="{i18n>Cancel}"
                type="Reject"
                class="sapUiTinyMarginBegin"
                press=".onCancelWeighing" />
            </HBox>
          <!-- <List id="ListID" headerText="A List" showSeparators="Inner"> </List> -->
        </IconTabFilter>
        <IconTabFilter id="iconTabItemFilter3" key="notes" text="{i18n>Classification/Transgenics}">
        <HBox id="HboxClassificationSave"  alignContent="Center" alignItems="Center">          
            <f:SimpleForm id="simpleFormIHumidity" layout="ResponsiveGridLayout">

                <f:toolbar>
                  <Toolbar id="TBHumidity">
                    <Title id="TitleiHumidity" text="{i18n>Humidity}"/>
                    <ToolbarSpacer id="ToolbarSpacerHumidity" />
                    <!-- <Button id="btnSalvarClassification" icon="sap-icon://save" press=".onSaveClassification"/>   -->
                                
                  </Toolbar>
              </f:toolbar>             
              <HBox id="idHumidityHBOX"  alignItems="Center" justifyContent="Center" fitContainer="true" >
               <VBox id="VBoxHumidity" alignItems="Center" justifyContent="Center" fitContainer="true">
                    <FlexBox id="flexBoxId3" wrap="NoWrap" fitContainer="true" alignContent="Center" >
                      
                        <Label id="labelHumidity" text="{i18n>Humidity}" />
                        <Input id="inputHumidity" type="Number" value="{Classification>/humidity}" editable="true" />

                        <Label id="labelResultHumidity" text="Resultado Umidade" visible="false" />
                        <Input id="inputResultHumidity" type="Number" value="{Classification>/resultHumidity}" visible="false" editable="true" />

                        <Label id="labelDiscountHumidity" text="{i18n>DiscountHumidity}" />
                        <Input id="inputDiscountHumidity" type="Number" value="{Classification>/discountHumidity}" editable="true" />
                      
                    </FlexBox>
                </VBox>
              </HBox>
            </f:SimpleForm>
             




            <f:SimpleForm id="simpleFormIimpurity" layout="ResponsiveGridLayout">

                <f:toolbar>
                  <Toolbar id="TBimpurity">
                    <Title id="Titleiimpurity" text="{i18n>Impurity}"/>
                    <ToolbarSpacer id="ToolbarSpacerimpurity" />
                    <!-- <Button id="btnSalvarClassification" icon="sap-icon://save" press=".onSaveClassification"/>   -->
                                
                  </Toolbar>
              </f:toolbar>
              
              <HBox id="idimpurityHBOX"  alignItems="Center" justifyContent="Start" fitContainer="true">
               <VBox id="VBoximpurity" alignItems="Center" justifyContent="Start" fitContainer="true">
                    <FlexBox id="flexBoxId4" wrap="NoWrap" fitContainer="true" >
                      
                        <Label id="labelImpurity" text="{i18n>Impurity}" />
                        <Input id="inputImpurity" type="Number" value="{Classification>/impurity}" editable="true" />

                        <Label id="labelResultImpurity" text="Resultado Impureza"  visible="false"/>
                        <Input id="inputResultImpurity" type="Number" value="{Classification>/resultImpurity}" visible="false" editable="true" />

                        <Label id="labelDiscountImpurity" text="{i18n>DiscountImpurity}" />
                        <Input id="inputDiscountImpurity" value="{Classification>/discountImpurity}" editable="true" />
                      
                    </FlexBox>
                    </VBox>
                  </HBox>
              </f:SimpleForm>


              <f:SimpleForm id="simpleFormIdamaged" layout="ResponsiveGridLayout">

                <f:toolbar>
                  <Toolbar id="TBdamaged">
                    <Title id="Titleidamaged" text="{i18n>damaged}"/>
                    <ToolbarSpacer id="ToolbarSpacerdamaged" />
                    <!-- <Button id="btnSalvarClassification" icon="sap-icon://save" press=".onSaveClassification"/>   -->
                                
                  </Toolbar>
              </f:toolbar>              
              <HBox id="idDamagedHBOX"  alignItems="Center" justifyContent="Start" fitContainer="true">
               <VBox id="VBoxdamaged" alignItems="Center" justifyContent="Start" fitContainer="true">
                    <FlexBox id="flexBoxId6" wrap="NoWrap" fitContainer="true" >
                      
                        <Label id="labelDamaged" text="{i18n>damaged%}" />                      
                        <Input id="inputDamaged" type="Number" value="{Classification>/damaged}" editable="true" />
                      

                      <Label id="labelResultDamaged" text="Resultado Avariado"  visible="false" />
                      <Input id="inputResultDamaged" type="Number" value="{Classification>/resultDamaged}" editable="true" visible="false"/>

                      
                      <Label id="labelDiscountDamaged" text="{i18n>Discountdamaged}" />
                      <Input id="inputDiscountDamaged" type="Number" value="{Classification>/discountDamaged}" editable="true" />
                      
                    </FlexBox>
                    </VBox>
                  </HBox>
              </f:SimpleForm>

              <f:SimpleForm id="simpleFormIgreenish" layout="ResponsiveGridLayout">
              <f:toolbar>
                <Toolbar id="TBgreenish">
                  <Title id="Titleimogreenish" text="{i18n>greenish}"/>
                  <ToolbarSpacer id="ToolbarSpacergreenish" />
                  <!-- <Button id="btnSalvarClassification" icon="sap-icon://save" press=".onSaveClassification"/>   -->
                              
                </Toolbar>
              </f:toolbar>
                <FlexBox id="flexBoxIdgreenish" wrap="NoWrap" fitContainer="true" >
              <VBox id="VBoxgreenish">
                <FlexBox id="flexBoxId5" wrap="NoWrap" fitContainer="true" >

                <Label id="labelGreenish" text="{i18n>greenish%}" />
                  <Input id="inputGreenish" type="Number" value="{Classification>/greenish}" editable="true" />

                  <Label id="labelResultGreenish" text="Resultado Esverdeado"  visible="false" />
                  <Input id="inputResultGreenish" type="Number" value="{Classification>/resultGreenish}" visible="false" editable="true" />

                  <Label id="labelDiscountGreenish" text="{i18n>Discountgreenish}" />
                  <Input id="inputDiscountGreenish" type="Number" value="{Classification>/discountGreenish}" editable="true" />
                </FlexBox> 
              
              </VBox>

              </FlexBox> 
              </f:SimpleForm>


              <!-- <VBox class="sapUiTinyMarginEnd" id="VBoxTransgenia">
                <f:SimpleForm id="simpleFormId4" layout="ResponsiveGridLayout">
                <Toolbar id="TB2">
                <Title id="Title2" text="Transgenia"/>
                <ToolbarSpacer id="ToolbarSpacer2" />
                <Button id="btnSalvarTransgenia" icon="sap-icon://save" press=".onSaveTransgenia"/>                              
              </Toolbar>
              <Label id="labelDeclarado" text="Declarado" />
              <CheckBox id="checkboxDeclarado" selected="{Transgenics>/declarado}" />

              <Label id="labelParticipante" text="Participante" />
              <CheckBox id="checkboxParticipante" selected="{Transgenics>/participante}" />

              <Label id="labelRREConvenciona" text="RR e Convenciona" />
              <CheckBox id="checkboxRREConvenciona" selected="{Transgenics>/rrConvenciona}" />

              <Label id="labelTestadaNegativa" text="Testada Negativa" />
              <CheckBox id="checkboxTestadaNegativa" selected="{Transgenics>/testadaNegativa}" />

              <Label id="labelTestadaPositiva" text="Testada Positiva" />
              <CheckBox id="checkboxTestadaPositiva" selected="{Transgenics>/testadaPositiva}" />              
               </f:SimpleForm>
              
              </VBox>
          </HBox>
            <HBox id="HboxTransgenia" class="sapUiTinyMarginBegin"> -->
               <!-- <f:SimpleForm id="simpleFormId4" layout="ResponsiveGridLayout">
                <Toolbar id="TB2">
                <Title id="Title2" text="Transgenia"/>
                <ToolbarSpacer id="ToolbarSpacer2" />
                <Button id="btnSalvarTransgenia" icon="sap-icon://save" press=".onSaveTransgenia"/>  
                            
              </Toolbar>
               </f:SimpleForm> -->
          <!-- <FeedInput id="fieldInputId"/> -->

          
        </HBox>
                <Toolbar id="TBTransgeics">
                  <Title id="TitleiTBTransgeics" text="{i18n>Transgenics}"/>
                  <ToolbarSpacer id="ToolbarSpacerTransgenics" />
                  <!-- <Button id="btnSalvarClassification" icon="sap-icon://save" press=".onSaveClassification"/>   -->
                              
                </Toolbar>
              <FlexBox id="flexBoxIdGreenish" wrap="NoWrap" fitContainer="true">
              
              
                <Label id="labelDeclarado" text="{i18n>avowed}" />
                <CheckBox id="checkboxDeclarado" selected="{Transgenics>/declarado}" />

                <Label id="labelParticipante" text="{i18n>Participant}" />
                <CheckBox id="checkboxParticipante" selected="{Transgenics>/participante}" />

                <Label id="labelRREConvenciona" text="{i18n>Convencional}" />
                <CheckBox id="checkboxRREConvenciona" selected="{Transgenics>/rrConvenciona}" />

                <Label id="labelTestadaNegativa" text="{i18n>Negative}" />
                <CheckBox id="checkboxTestadaNegativa" selected="{Transgenics>/testadaNegativa}" />

                <Label id="labelTestadaPositiva" text="{i18n>Positive}" />
                <CheckBox id="checkboxTestadaPositiva" selected="{Transgenics>/testadaPositiva}" /> 


              <Button
                id="btnSaveClassification"
                text="{i18n>Save}"
                type="Default"
                class="sapUiTinyMarginBegin"
                press=".onSaveClassification" />
              </FlexBox>
        </IconTabFilter>
      </items>
    </IconTabBar>
    </content>
  </Page>
</mvc:View>
