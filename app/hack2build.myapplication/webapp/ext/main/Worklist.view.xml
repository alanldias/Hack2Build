<mvc:View xmlns:mvc="sap.ui.core.mvc"
	xmlns="sap.m"
	xmlns:layout="sap.ui.layout"	
	xmlns:f="sap.ui.layout.form"
	controllerName="hack2build.myapplication.ext.main.Worklist">
	<Page
		id="idPage"		
		title="{i18n>weighingTitle}"
		class= "sapUiResponsivePadding--header" >
		
			
    
    <List
      id="vehicleList"
      mode="None"
      items="{
        path: '/Weighing'
      }"
      >
		<StandardListItem id="vehicleListItem"
		title="{weighingID}"
		description="{vehicleLicensePlate}"
		type="Active"
		 />
    </List>
	 <HBox id="HboxButton" class="sapUiTinyMarginBegin">
              <Button
                id="btnNewWeighing"
                text="{i18n>NewWeighing}"
                type="Emphasized"
                press=".onNewWeighing" />
             
            </HBox>

  </Page>
		



