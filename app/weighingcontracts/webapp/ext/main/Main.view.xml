<mvc:View xmlns:tnt="sap.tnt" xmlns:core="sap.ui.core" xmlns:mvc="sap.ui.core.mvc" xmlns="sap.m" xmlns:macros="sap.fe.macros" 	xmlns:l="sap.ui.layout"
    xmlns:html="http://www.w3.org/1999/xhtml" controllerName="weighingcontracts.ext.main.Main">

    <Page
		id="idPage"		
		title="{i18n>weighingTitle}"
		class= "sapUiResponsivePadding--header" >

        <l:ResponsiveSplitter id="responsiveSplitter" height="100%">
		    <l:PaneContainer id="idPaneContainer">
                <l:SplitPane id="idSplitPane" requiredParentWidth="500">

                <Table id="idWeighingTableleft"
								contextualWidth="Auto"
								selectionChange=".onWeighingSelect"
								popinLayout="GridSmall"
                                mode="SingleSelect"
								headerText="{i18n>weighingTitle}"
								items="{
								path: '/WeighingDetails'
							}">
							<columns>
								<Column id="idWeighingColumn">
									<header>
										<Text id="Text" text="{i18n>Date}" />
									</header>
								</Column>
								<Column id="idWeighingColumn2">
									<header>
										<Text id="Textw2" text="{i18n>Time}" />
									</header>
								</Column>
								<Column id="idWeighingColumn3">
									<header>
										<Text id="TextCw3" text="{i18n>Plate}" />
									</header>
								</Column>
								<Column id="idWeighingColumn4">
									<header>
										<Text id="TextCw4" text="{i18n>ProductCode}" />
									</header>
								</Column>
								<Column id="idWeighingColumn5">
									<header>
										<Text id="TextCw5" text="{i18n>ProductName}" />
									</header>
								</Column>
								<Column id="idWeighingColumn6">
									<header>
										<Text id="TextCw6" text="{i18n>Supplier}" />
									</header>
								</Column>
								<Column id="idWeighingColumn7">
									<header>
										<Text id="TextCw7" text="{i18n>netWeight}" />
									</header>
								</Column>
                                </columns>
							<items>
								<ColumnListItem id="idProductColumnItem">
									<cells>
										<Label id="Lbl1"
											text="{weighingDate}"/>
										<Label id="Lbl2"
											text="{weighingDate}" />
										<Label id="Lbl3"
											text="{vehiclePlate}" />
										<Label id="Lbl4"
											text="{material}" />
										<Label id="Lbl5"
											text="{materialName}" />
										<Label id="Lbl6"
											text="{supplier}" />
										<Label id="Lbl7"
											text="{netWeight}" />
                                            </cells>
								</ColumnListItem>
							</items>
						</Table>
		
			
            
                            <!-- <List
                            id="vehicleList"
                            mode="MultiSelect"
                            items="{
                                path: '/Weighing'
                            }"
                            itemPress=".onWeighingPress">
                                <StandardListItem id="vehicleListItem"
                                title="{weighingID}"
                                description="{vehicleLicensePlate}"
                                type="Active"
                                />
                            </List> -->
                            <!-- <HBox id="HboxButton" class="sapUiTinyMarginBegin">
                                    <Button
                                        id="btnNewWeighing"
                                        text="Adicionar a nota"
                                        type="Emphasized"
                                        press=".onNewWeighing" />
                                    
                                    </HBox><Button
                                        id="btnRefresh"
                                        text="Atualizar"
                                        type="Default"
                                        press=".onRefresh" />    -->

            </l:SplitPane>
            <l:SplitPane id="Splitpane2" requiredParentWidth="400">
			
                 <Table id="idContractsTableleft"
								contextualWidth="Auto"
								popinLayout="GridSmall"
								visible="false"
                                mode="SingleSelect"
								headerText="Contracts"
								items="{
								path: '/ContractVehicleListView',
								 model: 'vwModel'
							}">				
							<infoToolbar>
								<tnt:ToolHeader id="infoToolbarHeader">
								<Button
									id="btnAddContract"
									text="Add to Contract"
									type="Emphasized"
									press=".onAddContract" />								
								</tnt:ToolHeader>
							</infoToolbar>			
							<columns>
								<Column id="idContractColumn">
									<header>
										<Text id="TextContract" text="{i18n>weighingContractsTitle}Contracts" />
									</header>
								</Column>
								
								<Column id="idContractColumn3">
									<header>
										<Text id="TextContract3" text="{i18n>ProductCode}" />
									</header>
								</Column>
								<Column id="idContractColumn4">
									<header>
										<Text id="TextContract4" text="{i18n>ProductName}" />
									</header>
								</Column>
								<Column id="idContractColumn5">
									<header>
										<Text id="TextContract5" text="{i18n>Supplier}" />
									</header>
								</Column>
								<Column id="idContractColumn6">
									<header>
										<Text id="TextContract6" text="{i18n>Amount}" />
									</header>
								</Column>


                                </columns>
							<items>
								<ColumnListItem id="idProductColumnItem2">
									<cells>
										<Label id="Lblcontract1"
											text="{vwModel>contractNumber}"/>
										<Label id="Lblcontract2"
											text="{vwModel>material}" />
										<Label id="Lblcontract3"
											text="{vwModel>materialName}" />
										<Label id="Lblcontract4"
											text="{vwModel>supplier}" />
										<Label id="Lblcontract5"
											text="{vwModel>amount}" />

											
									</cells>
								</ColumnListItem>
							</items>
						</Table>

						

            </l:SplitPane>
		</l:PaneContainer>
	</l:ResponsiveSplitter>

  </Page>
    <!-- <Page id="Main" title="{i18n>MainTitle}">
        <content></content>
    </Page> -->
</mvc:View>